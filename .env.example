# Copy to .env.local (gitignored). Read by the dev server and `npm run eval`; never sent to the browser.

# Claude Code engine (default): uses your Claude Code login — run `claude` once and /login. No key needed.
# CLAUDE_CODE_MODEL=opus          # default: your Claude Code default model
# CLAUDE_CODE_EFFORT=high         # low | medium | high | xhigh | max
# CLAUDE_CODE_BIN=claude          # path to the CLI if it isn't on PATH

# Codex engine: uses your Codex login — run `codex login` and sign in with ChatGPT.
# Select Codex in the app's AI provider menu. No separate API key needed.
# CODEX_MODEL=gpt-6-sol          # default: your Codex default model
# CODEX_EFFORT=high              # low | medium | high | xhigh | max | ultra
# CODEX_BIN=codex                # executable path; Codex desktop's bundled CLI is detected automatically

# API engine (optional): billed per token.
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5
# AI_EFFORT=high

# Evals: AI_ENGINE=claude-code | api (default: api if ANTHROPIC_API_KEY is set), EVAL_CONCURRENCY=3
